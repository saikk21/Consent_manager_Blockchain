# Sammati Ledger — local environment template
# Full setup: docs/quickstart.md
# Repo overview: README.md

# PostgreSQL connection (local or Docker). URL-encode special chars in password (e.g. @ -> %40).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sammati_ledger

# HTTP port for the API (default 3000).
PORT=3000

# Optional: extra secret mixed into API key hashing (same value must be used for all processes that verify keys).
API_KEY_HASH_PEPPER=

# Widget session token signing (Phase C.2).
# For local dev keep one key; production should rotate keys and use JSON key map.
WIDGET_SESSION_SIGNING_KID=wsk-dev-1
WIDGET_SESSION_SIGNING_KEY=dev-widget-session-signing-key
# Optional multi-key format: {"kid-1":"secret-1","kid-2":"secret-2"}
WIDGET_SESSION_SIGNING_KEYS_JSON=
